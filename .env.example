# ==========================================
# DFY 个人 AI 终端 - 环境变量示例
# 复制此文件为 .env 并填入你自己的 Key
# ==========================================

# DeepSeek API Key (必填)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily 搜索 API Key (用于 Agent 联网检索)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据库配置 (默认使用 SQLite)
DATABASE_URL=sqlite:///./dev.db


# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379